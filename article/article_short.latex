    \includegraphics[height=0.1\textheight]{figures/segment_rough_original.png} &
	\includegraphics[height=0.1\textheight]{figures/segment_rough_heatmap_128.png} \\
    \scriptsize (a) Input image from \cite{holm2017drhagis} & \scriptsize (b) Heatmap at Section~\ref{subsubsec:step6_stage1} \\
    \includegraphics[height=0.1\textheight]{figures/segment_rough_heatmap_64.png} &
	\includegraphics[height=0.1\textheight]{figures/segment_rough_heatmap_32.png} \\
